# Dependencies
node_modules/

# Game artwork taken from the Tabletop Simulator build. It is copyrighted by the publisher,
# so it is not redistributed in this repo. Copy the folder in locally (see README).
/assets/

# Build output that is regenerated by `npm run build` (dist/app.js is kept on purpose,
# so index.html works when opened directly from disk)
dist/*.map

# Static site copied by scripts/publish-site.mjs (Vercel's output directory)
/public/

# Local editor / Claude Code settings (launch.json stays tracked)
.claude/settings.local.json
.claude/worktrees/
.vscode/
.idea/
*.swp

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# Test / coverage / temp output
coverage/
.cache/
tmp/
temp/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
