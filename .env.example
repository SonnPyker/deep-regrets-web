# Nothing loads this file automatically. Set these in the Vercel and Render dashboards for deployment,
# or export them in your shell for local runs. Never commit real values.

# Vercel build (frontend): URL of the co-op server, without a trailing slash.
DR_API_URL=https://deep-regret-coop.onrender.com

# Render (server): web origins allowed to call the server, comma-separated, without trailing slashes.
ALLOWED_ORIGINS=https://deep-regret.vercel.app

# Render (server): Supabase project. Without these, rooms are kept in memory and are lost on restart.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
